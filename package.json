{
  "name": "pengu-recorder",
  "productName": "Pengu Recorder",
  "version": "0.2.0",
  "description": "Screen and camera recorder with templates. Its own controls and notes never appear in the recording.",
  "license": "MIT",
  "author": "Christian Monge Guerrero",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"Pengu Recorder\" --platform=win32 --arch=x64 --out=out --overwrite --icon=assets/pengu-recorder.ico --prune=true --ignore=^/out --ignore=^/node_modules --ignore=^/[.] --ignore=^/backgrounds-export --ignore=^/MEJORAS --ignore=start-pengu-recorder"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.1"
  }
}
